# Runtime state, not source.
data/
tmp/
logs/
*.log

# Local overrides: API_TOKEN, proxy credentials. Loaded before xmoat.cfg and
# therefore wins over it.
xmoat.local.cfg

# The runtime is not tracked; copy bin/xnet or bin/xnet.exe from xnet2lua.
bin/

# Editor and assistant local state.
.claude/
.vscode/
