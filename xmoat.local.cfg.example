# Copy to xmoat.local.cfg (gitignored). Loaded before xmoat.cfg, so anything
# here wins over it. Set only the channels you use.

# Required before LISTEN_HOST may be anything but loopback.
# API_TOKEN=a-long-random-string

# HTTP_PROXY=socks5h://127.0.0.1:1080

# 企业微信群机器人：群设置 → 群机器人 → 添加，复制 Webhook 地址
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...

# 企业微信应用：发给成员本人，不需要群。管理后台 → 我的企业 拿企业 ID，
# 应用管理 → 自建应用 拿 AgentId 和 Secret；三个都填才启用。
# 收件人是成员 UserID（通讯录里那个账号），多个用 | 分隔，@all 是应用可见范围内所有人。
# 注意：可信 IP 为空时应用只能发给自己，要发给别人得在应用里配置企业可信 IP。
# WECOM_CORP_ID=ww...
# WECOM_CORP_SECRET=...
# WECOM_AGENT_ID=1000002
# WECOM_TO_USER=@all

# 飞书群机器人：自定义机器人；开启"签名校验"时填 FEISHU_SECRET
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
# FEISHU_SECRET=...

# 钉钉群机器人：安全设置选"加签"时填 DINGTALK_SECRET（SEC 开头）
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_SECRET=SEC...

# Telegram：@BotFather 创建机器人拿 token；chat_id 可以是个人或群
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_PROXY=socks5h://127.0.0.1:1080

# 任意接收端，POST JSON：{source, title, text, markdown, events}
# WEBHOOK_URL=https://example.com/xmoat
# WEBHOOK_BEARER=...

# 大模型（可选，用于解读年报经营评述和问答；会产生费用）
# Claude：
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5

# DeepSeek、通义千问等 OpenAI 兼容接口：
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_FALLBACKS=0
